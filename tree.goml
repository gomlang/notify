package notify;

use std::fs;
use std::io;
use std::time;

struct PendingMove {
    path: string,
    since: time::Instant,
}

struct State {
    fd: Ref[Option[usize]],
    root: string,
    recursive: bool,
    options: Options,
    watches: HashMap[i32, string],
    paths: HashMap[string, i32],
    moves: HashMap[u32, PendingMove],
    buffer: Vec[byte],
    rescan: Ref[bool],
    close_requested: Ref[bool],
    pending: Ref[Option[Vec[Event]]],
}

fn child_path(parent: string, child: string) -> string {
    if parent.ends_with("/") {
        parent + child
    } else {
        parent + "/" + child
    }
}

fn close_state(state: State) -> Result[(), fs::Error] {
    let fd = state.fd.get();
    state.fd.set(Option::None);
    state.rescan.set(false);
    state.pending.set(Option::None);
    for (wd, _) in state.watches.entries() {
        state.watches.remove(wd);
    }
    for (name, _) in state.paths.entries() {
        state.paths.remove(name);
    }
    for (cookie, _) in state.moves.entries() {
        state.moves.remove(cookie);
    }
    match fd {
        Some(value) => close_fd(value),
        None => Result::Ok(()),
    }
}

fn vanished(value: fs::Error) -> bool {
    value.kind() == io::ErrorKind::NotFound || value.raw_os_code() == Option::Some(20)
        || value.raw_os_code() == Option::Some(40)
}

fn add_tree(state: State, root: string, required: bool) -> Result[(), fs::Error] {
    let fd = state.fd.get().ok_or(closed())?;
    let pending = Vec::from_array([root]);
    let visited: HashMap[i32, bool] = HashMap::new();
    while let Some(directory) = pending.pop() {
        if ignored(state, directory, true) {
            continue;
        }
        for (_, moved) in state.moves.entries() {
            if within(directory, moved.path) {
                remove_tree(state, moved.path)?;
            }
        }
        let only_directory = state.recursive || directory != state.root;
        let wd = match add_watch(fd, directory, state.options.mask, only_directory) {
            Ok(value) => value,
            Err(value) => {
                if vanished(value) && !(required && directory == root) {
                    continue;
                }
                return Result::Err(value);
            },
        };
        if visited.contains(wd) {
            continue;
        }
        visited.insert(wd, true);
        // A scan sees the current filesystem, while queued events describe its past.
        // Conflicting identities require a fresh queue, not a path-only rename.
        if let Some(previous) = state.paths[directory] {
            if previous != wd {
                state.rescan.set(true);
                return Result::Ok(());
            }
        }
        if let Some(previous) = state.watches[wd] {
            if previous != directory {
                if within(directory, previous) || within(previous, directory) {
                    continue;
                }
                state.rescan.set(true);
                return Result::Ok(());
            }
        }
        state.watches.insert(wd, directory);
        state.paths.insert(directory, wd);
        if !state.recursive {
            continue;
        }
        let names = match fs::read_dir(directory) {
            Ok(value) => value,
            Err(value) => {
                match fs::symlink_metadata(directory) {
                    Err(metadata_error) => {
                        if vanished(metadata_error) {
                            continue;
                        }
                    },
                    Ok(metadata) => {
                        if !metadata.file_type().is_dir() {
                            continue;
                        }
                    },
                }
                return Result::Err(value);
            },
        };
        for name in names {
            let child = child_path(directory, name);
            match fs::symlink_metadata(child) {
                Ok(metadata) => {
                    if metadata.file_type().is_dir() {
                        pending.push(child);
                    }
                },
                Err(value) => {
                    if !vanished(value) {
                        return Result::Err(value);
                    }
                },
            }
        }
    }
    Result::Ok(())
}

fn within(value: string, directory: string) -> bool {
    value == directory
        || value.starts_with(
            if directory == "/" {
                directory
            } else {
                directory + "/"
            },
        )
}

fn remove_tree(state: State, directory: string) -> Result[(), fs::Error] {
    let fd = state.fd.get().ok_or(closed())?;
    for (wd, name) in state.watches.entries() {
        if within(name, directory) {
            state.watches.remove(wd);
            state.paths.remove(name);
            remove_watch(fd, wd)?;
        }
    }
    for (cookie, pending) in state.moves.entries() {
        if within(pending.path, directory) {
            state.moves.remove(cookie);
        }
    }
    Result::Ok(())
}

fn rename_tree(state: State, from: string, to: string) -> Result[(), fs::Error] {
    if from == to {
        return Result::Ok(());
    }
    remove_tree(state, to)?;
    for (wd, name) in state.watches.entries() {
        if within(name, from) {
            let renamed = to + name.byte_slice(from.byte_len(), name.byte_len());
            state.paths.remove(name);
            state.watches.insert(wd, renamed);
            state.paths.insert(renamed, wd);
        }
    }
    for (cookie, pending) in state.moves.entries() {
        if within(pending.path, from) {
            state.moves.insert(
                cookie,
                PendingMove {
                    path: to + pending.path.byte_slice(from.byte_len(), pending.path.byte_len()),
                    since: pending.since,
                },
            );
        }
    }
    for (_, name) in state.watches.entries() {
        if ignored(state, name, true) {
            remove_tree(state, name)?;
        }
    }
    Result::Ok(())
}

fn suspended(state: State, name: string) -> bool {
    for (_, pending) in state.moves.entries() {
        if within(name, pending.path) {
            return true;
        }
    }
    false
}

fn expire_moves(state: State) -> Result[(), fs::Error] {
    for (_, pending) in state.moves.entries() {
        if pending.since.elapsed().as_milliseconds() >= 100 {
            remove_tree(state, pending.path)?;
        }
    }
    Result::Ok(())
}

fn rebuild(state: State) -> Result[(), fs::Error] {
    close_state(state)?;
    state.fd.set(Option::Some(init()?));
    add_tree(state, state.root, true)
}

fn process_events(state: State, records: Vec[RawEvent]) -> Result[Vec[Event], fs::Error] {
    let result = Vec::new();
    if state.rescan.get() {
        rebuild(state)?;
        result.push(Event { path: state.root, mask: 0, cookie: 0, rescan: true });
        return Result::Ok(result);
    }
    for record in records {
        if record.mask & Q_OVERFLOW != 0 {
            rebuild(state)?;
            result.push(Event { path: state.root, mask: Q_OVERFLOW, cookie: 0, rescan: true });
            break;
        }
        let directory = match state.watches[record.wd] {
            Some(value) => value,
            None => continue,
        };
        if record.mask & IGNORED != 0 {
            state.watches.remove(record.wd);
            state.paths.remove(directory);
        }
        if suspended(state, directory) {
            continue;
        }
        let name = if record.name == "" {
            directory
        } else {
            child_path(directory, record.name)
        };
        let is_dir = record.mask & IS_DIR != 0;
        let exclude = ignored(state, name, is_dir);
        let mut rescan = false;
        if state.recursive && is_dir {
            if record.mask & MOVED_FROM != 0 {
                if let Some(previous) = state.moves[record.cookie] {
                    remove_tree(state, previous.path)?;
                }
                state.moves.insert(
                    record.cookie,
                    PendingMove { path: name, since: time::Instant::now() },
                );
            }
            if record.mask & MOVED_TO != 0 {
                if let Some(previous) = state.moves.remove_value(record.cookie) {
                    if exclude {
                        remove_tree(state, previous.path)?;
                    } else {
                        rename_tree(state, previous.path, name)?;
                    }
                }
            }
            if !exclude && record.mask & (CREATE | MOVED_TO) != 0 {
                add_tree(state, name, false)?;
                rescan = true;
            }
            if record.mask & DELETE != 0 {
                remove_tree(state, name)?;
            }
        }
        let event = Event { path: name, mask: record.mask, cookie: record.cookie, rescan };
        if visible_event(state, event) {
            result.push(event);
        }
        if state.rescan.get() {
            rebuild(state)?;
            result.push(Event { path: state.root, mask: 0, cookie: 0, rescan: true });
            break;
        }
        if record.name == "" && directory == state.root
            && record.mask & (DELETE_SELF | MOVE_SELF | UNMOUNT | IGNORED) != 0 {
            close_state(state)?;
            break;
        }
    }
    Result::Ok(result)
}

fn read_batch(state: State) -> Result[Vec[Event], fs::Error] {
    if let Some(events) = state.pending.get() {
        state.pending.set(Option::None);
        return Result::Ok(events);
    }
    let records = read_kernel(state)?;
    if records.len() == 0 {
        expire_moves(state)?;
    }
    process_events(state, records)
}
