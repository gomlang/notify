package notify;

use std::fs;
use std::io;
use std::task;
use std::time;

pub struct WatchId {
    value: u64,
}

impl PartialEq for WatchId {
    fn eq(self: WatchId, other: WatchId) -> bool {
        self.value == other.value
    }
}

impl Eq for WatchId {}

impl Hash for WatchId {
    fn hash(self: WatchId) -> u64 {
        self.value.hash()
    }
}

impl Debug for WatchId {
    fn debug(self: WatchId) -> string {
        "WatchId(" + self.value.to_string() + ")"
    }
}

impl WatchId {
    pub fn value(self: WatchId) -> u64 {
        self.value
    }
}

pub struct WatchInfo {
    pub id: WatchId,
    pub path: string,
    pub options: Options,
}

pub enum Notice {
    Event(WatchId, Event),
    Error(WatchId, fs::Error),
    Removed(WatchId),
}

struct Registration {
    info: WatchInfo,
    state: State,
}

struct SetState {
    closed: Ref[bool],
    next: Ref[u64],
    registrations: HashMap[WatchId, Registration],
    pending: Ref[Option[Vec[Notice]]],
    poll_buffer: Vec[byte],
}

pub struct WatchSet {
    state: Channel[SetState],
    stop: Channel[()],
}

impl WatchSet {
    pub fn new() -> WatchSet {
        let state = Channel::new(1);
        state.send(
            SetState {
                closed: Ref::new(false),
                next: Ref::new(1),
                registrations: HashMap::new(),
                pending: Ref::new(Option::None),
                poll_buffer: Vec::new(),
            },
        );
        WatchSet { state, stop: Channel::new(0) }
    }

    pub fn add(self: WatchSet, path: string) -> Result[WatchId, fs::Error] {
        self.add_with(path, Options::new())
    }

    pub fn add_recursive(self: WatchSet, path: string) -> Result[WatchId, fs::Error] {
        self.add_with(path, Options::new().with_recursive(true))
    }

    pub fn add_with(self: WatchSet, path: string, options: Options) -> Result[WatchId, fs::Error] {
        let state = self.state.recv().ok_or(closed())?;
        defer self.state.send(state);
        require_set_open(state)?;
        if state.next.get() == 0 {
            return Result::Err(error(io::ErrorKind::Other, "watch identifiers exhausted"));
        }
        let root = open_state(path, options)?;
        let id = WatchId { value: state.next.get() };
        state.next.set(id.value + 1);
        let info = WatchInfo { id, path: root.root, options };
        state.registrations.set(id, Registration { info, state: root });
        Result::Ok(id)
    }

    pub fn remove(self: WatchSet, id: WatchId) -> Result[bool, fs::Error] {
        let state = self.state.recv().ok_or(closed())?;
        defer self.state.send(state);
        require_set_open(state)?;
        match state.registrations.remove_value(id) {
            Some(value) => {
                close_state(value.state)?;
                Result::Ok(true)
            },
            None => Result::Ok(false),
        }
    }

    pub fn watches(self: WatchSet) -> Result[Vec[WatchInfo], fs::Error] {
        let state = self.state.recv().ok_or(closed())?;
        defer self.state.send(state);
        require_set_open(state)?;
        let result = Vec::new();
        for (_, registration) in state.registrations.entries() {
            result.push(registration.info);
        }
        Result::Ok(result)
    }

    pub fn try_read(self: WatchSet) -> Result[Vec[Notice], fs::Error] {
        let state = self.state.recv().ok_or(closed())?;
        defer self.state.send(state);
        read_set(state)
    }

    pub fn read(self: WatchSet, timeout: time::Duration) -> Result[Vec[Notice], fs::Error] {
        let start = time::Instant::now();
        loop {
            let events = self.try_read()?;
            if !events.is_empty() {
                return Result::Ok(events);
            }
            let remaining = timeout.saturating_subtract(start.elapsed());
            if remaining.is_zero() {
                return Result::Ok(events);
            }
            let milliseconds = if remaining.as_nanoseconds() >= 50000000 {
                50
            } else {
                (remaining.as_nanoseconds() + 999999) / 1000000
            };
            self.wait(milliseconds.to_usize())?;
        }
    }

    pub fn read_with(self: WatchSet, cancel: task::CancelToken, timeout: time::Duration) -> Result[
        task::WaitResult[Vec[Notice]],
        fs::Error,
    ] {
        read_with_state(
            self.state,
            cancel,
            timeout,
            read_set,
            wait_set,
            |state, events| state.pending.set(Option::Some(events)),
        )
    }

    fn wait(self: WatchSet, milliseconds: usize) -> Result[(), fs::Error] {
        let state = self.state.recv().ok_or(closed())?;
        defer self.state.send(state);
        wait_set(state, milliseconds)
    }

    pub fn is_closed(self: WatchSet) -> bool {
        match self.state.recv() {
            Some(state) => {
                let result = state.closed.get();
                self.state.send(state);
                result
            },
            None => true,
        }
    }

    pub fn subscribe(self: WatchSet, scope: task::Scope, capacity: isize) -> Result[
        Subscription[Notice],
        fs::Error,
    ] {
        if self.is_closed() {
            return Result::Err(closed());
        }
        subscribe_source(
            scope,
            capacity,
            || self.read(time::Duration::from_milliseconds(50)),
            || self.close(),
            || self.is_closed(),
            self.stop.receiver(),
        )
    }

    pub fn close(self: WatchSet) -> Result[(), fs::Error] {
        let state = self.state.recv().ok_or(closed())?;
        defer self.state.send(state);
        if !state.closed.get() {
            state.closed.set(true);
            self.stop.close();
        }
        state.pending.set(Option::None);
        let mut first = Option::None;
        for (id, registration) in state.registrations.entries() {
            if let Err(error) = close_state(registration.state) {
                if first.is_none() {
                    first = Option::Some(error);
                }
            }
            state.registrations.remove(id);
        }
        match first {
            Some(error) => Result::Err(error),
            None => Result::Ok(()),
        }
    }
}

fn require_set_open(state: SetState) -> Result[(), fs::Error] {
    if state.closed.get() {
        Result::Err(closed())
    } else {
        Result::Ok(())
    }
}

fn read_set(state: SetState) -> Result[Vec[Notice], fs::Error] {
    require_set_open(state)?;
    if let Some(events) = state.pending.get() {
        state.pending.set(Option::None);
        return Result::Ok(events);
    }
    let result = Vec::new();
    let registrations = state.registrations.entries();
    if registrations.len() > 1 {
        poll_into(registration_fds(registrations), 0, state.poll_buffer)?;
    }
    for index in 0..registrations.len() {
        let (id, registration) = registrations[index];
        let batch = if registrations.len() > 1 {
            read_ready(registration.state, state.poll_buffer[index * 8 + 6])
        } else {
            read_batch(registration.state).map(|events| Option::Some(events))
        };
        match batch {
            Ok(Some(events)) => {
                for event in events {
                    result.push(Notice::Event(id, event));
                }
            },
            Ok(None) => (),
            Err(error) => {
                result.push(Notice::Error(id, error));
                let _ = close_state(registration.state);
            },
        }
        if registration.state.fd.get().is_none() {
            state.registrations.remove(id);
            result.push(Notice::Removed(id));
        }
    }
    Result::Ok(result)
}

fn registration_fds(registrations: Vec[(WatchId, Registration)]) -> Vec[usize] {
    let fds = Vec::new();
    for (_, registration) in registrations {
        // poll ignores negative descriptors; retain each registration's array position.
        fds.push(registration.state.fd.get().unwrap_or((-1).to_usize()));
    }
    fds
}

fn wait_set(state: SetState, milliseconds: usize) -> Result[(), fs::Error] {
    require_set_open(state)?;
    // Per-descriptor failures are reported by read_set as Error/Removed notices.
    poll_into(registration_fds(state.registrations.entries()), milliseconds, state.poll_buffer)
}

fn read_ready(state: State, revents: byte) -> Result[Option[Vec[Event]], fs::Error] {
    if revents & 0x38 != 0 {
        return Result::Err(poll_error());
    }
    if revents & 1 != 0 || state.pending.get().is_some() || state.rescan.get()
        || state.fd.get().is_none() {
        return read_batch(state).map(|events| Option::Some(events));
    }
    if state.moves.len() > 0 {
        expire_moves(state)?;
    }
    Result::Ok(Option::None)
}
